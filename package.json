{
  "name": "dsh-workspace-categories",
  "version": "1.0.0",
  "description": "Group the DSH sidebar workspaces into custom categories: All/Recent/Categories views, two-level folding, long-press drag to file. No more endless scrolling to find a session.",
  "type": "module",
  "scripts": {
    "test": "node tools/run-all.mjs"
  },
  "license": "MIT",
  "author": "Znk1314",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Znk1314/dsh-workspace-categories.git"
  },
  "bugs": {
    "url": "https://github.com/Znk1314/dsh-workspace-categories/issues"
  },
  "homepage": "https://github.com/Znk1314/dsh-workspace-categories#readme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-desktop",
    "sidebar",
    "workspace",
    "categories",
    "dsh-bundle"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/preview.png",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
